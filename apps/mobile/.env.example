# --- Appwrite (mobile / Expo) ---
# Copy this file to `.env` and fill in your Appwrite Cloud project values.
# Expo inlines EXPO_PUBLIC_* vars into the app at build time.

EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your-project-id
EXPO_PUBLIC_APPWRITE_DATABASE_ID=sync_main

# Bundle id / package name registered as a Platform in the Appwrite console.
EXPO_PUBLIC_APP_BUNDLE_ID=com.packngo.app

# Appwrite Messaging → Providers → your FCM provider → its Provider ID.
# Push registration is skipped (with a warning) until this is set.
EXPO_PUBLIC_APPWRITE_FCM_PROVIDER_ID=your-fcm-provider-id

# Maps use MapLibre (@maplibre/maplibre-react-native) + OpenFreeMap tiles —
# no API key needed. Optionally override the default style URL below.
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
