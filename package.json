{
  "name": "sync",
  "private": true,
  "version": "1.0.0",
  "description": "Sync — group travel companion app (web + mobile), backed by Appwrite",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@sync/web",
    "dev:mobile": "turbo run dev --filter=@sync/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "setup:appwrite": "node scripts/setup-appwrite.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "node-appwrite": "^27.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
