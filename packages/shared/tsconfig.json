{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": true,
    "types": [],
    // URL / URLSearchParams (WHATWG) live in the DOM lib but are globals in
    // every runtime this package targets (browser, Hermes/RN, Node).
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
